{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tcli",
  "version": "0.1.0",
  "identifier": "dev.timmo.tcli",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tcli",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NDI1MzNDNTE1NTdGNzYKUldSMmYxVlJQRk5DU0hRYy96RnVVMlhtakg4enozS0xCaW1pbVZoVnMwZGdlT1V4VG1NYVVEWUoK",
      "endpoints": [
        "https://github.com/XHTimmo/tcli/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
